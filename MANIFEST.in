include b3_run.py
include b3_debug.py
include CHANGELOG README.md
include b3/sql/*.sql
include b3/sql/mysql/*.sql
include b3/sql/postgresql/*.sql
include b3/sql/sqlite/*.sql
include b3/conf/*.ini
include b3/conf/templates/*.tpl
include b3/conf/templates/autodoc/*.html
include b3/docs/*.txt
include b3/docs/*.pdf
include b3/plugins/adv/CHANGELOG
